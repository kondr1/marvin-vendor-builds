# wpa_supplicant build configuration for Marvin.
#
# This file is complete: exactly what is listed here gets enabled. The station
# side needs far less than the access point side — no EAP, no enterprise
# authentication, no D-Bus. The uplink is somebody's home network, and what it
# asks for is WPA2 or WPA3 with a passphrase.

# Driver and netlink. LIBNL32 means building against libnl-3.x.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# Control interface over a UNIX socket: marvind talks to the running
# supplicant through it — asks for association state and triggers a rescan
# without restarting the process.
CONFIG_CTRL_IFACE=y

# Configuration comes from a file that marvind writes. The alternative
# backends store credentials elsewhere and would split the source of truth.
CONFIG_BACKEND=file

# Crypto from OpenSSL rather than the built-in implementation: the built-in one
# is less well tested and gets no security updates of its own.
CONFIG_TLS=openssl

# WPA3-Personal. Needed to associate with an upstream point that runs SAE —
# increasingly the default on new home routers.
CONFIG_SAE=y

# Opportunistic Wireless Encryption — encryption on open networks.
CONFIG_OWE=y

# epoll instead of select — cheaper on CPU under Linux.
CONFIG_ELOOP_EPOLL=y
