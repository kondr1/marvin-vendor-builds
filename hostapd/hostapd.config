# hostapd build configuration for Marvin.
#
# This file is complete: exactly what is listed here gets enabled. Everything
# else is left out — less code on the device and a smaller attack surface. The
# access point is driven through nl80211; no other driver exists on the target.

# Driver and netlink. LIBNL32 means building against libnl-3.x.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# Bands and modes. Measured on the board: the RTL8812AU dongle is 802.11ac and
# the onboard BCM43455 is ac as well, but which radio ends up serving the AP is
# decided by the on-device resolver, so both generations stay enabled rather
# than betting on one adapter.
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y

# WPA3-Personal (SAE) and the transition mode with WPA2-PSK.
CONFIG_SAE=y

# Opportunistic Wireless Encryption — encryption on open networks.
CONFIG_OWE=y

# Automatic channel selection: neither the country nor the RF environment is
# known in advance.
CONFIG_ACS=y

# Crypto from OpenSSL rather than hostapd's built-in implementation: the
# built-in one is less well tested and gets no security updates of its own.
CONFIG_TLS=openssl

# epoll instead of select — cheaper on CPU under Linux.
CONFIG_ELOOP_EPOLL=y
