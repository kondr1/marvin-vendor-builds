# Конфигурация сборки hostapd для Marvin.
#
# Файл полный: включено ровно то, что перечислено. Всё лишнее не собирается —
# меньше кода на устройстве и меньше поверхности атаки. Управление точкой
# доступа идёт через nl80211, других драйверов на цели нет.

# Драйвер и netlink. LIBNL32 — сборка против libnl-3.x.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# Диапазоны и режимы: RTL8812AU — 802.11ac, встроенный AIC8800 — ax.
# Конкретное радио под AP выбирает резолвер, поэтому собираем оба режима.
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y

# WPA3-Personal (SAE) и переходный режим с WPA2-PSK.
CONFIG_SAE=y

# Opportunistic Wireless Encryption — шифрование в открытых сетях.
CONFIG_OWE=y

# Автовыбор канала: страна и обстановка в эфире заранее неизвестны.
CONFIG_ACS=y

# Криптография из OpenSSL, а не встроенная реализация hostapd: встроенная
# слабее протестирована и не получает отдельных security-обновлений.
CONFIG_TLS=openssl

# epoll вместо select — на Linux дешевле по CPU.
CONFIG_ELOOP_EPOLL=y
